{
  "name": "botmarket",
  "version": "1.0.1",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/gitrepo.git"
  },
  "author": "Shachar Cz",
  "license": "ISC",
  "homepage": "https://github.com/...",
  "dependencies": {
    "openai": "^4.0.0",
    "rimraf": "^6.0.1",
    "serverless": "^1.50.0",
    "serverless-pseudo-parameters": "^2.5.0",
    "serverless-s3-sync": "^3.3.0"
  },
  "scripts": {
    "start": "react-app-rewired start",
    "test": "react-app-rewired test",
    "eject": "react-scripts eject",
    "build": "tsc",
    "watch": "tsc -w",
    "cdk": "cdk",
    "cdk:diff": "tsc && cdk diff --context stage=$STAGE --ci",
    "cdk:destroy": "tsc && cdk destroy --context stage=$STAGE -f --ci",
    "cdk:doctor": "tsc && cdk doctor",
    "cdk:deploy": "tsc && cdk deploy --context stage=$STAGE --require-approval never",
    "cdk:version": "cdk --version",
    "sls": "serverless",
    "sls:destroy": "serverless remove --stage $STAGE --region $AWS_REGION",
    "sls:deploy": "serverless deploy --stage $STAGE --region $AWS_REGION"
  },
  "devDependencies": {
    "@aws-cdk/cdk": "~0.31.0",
    "@types/request-promise-native": "^1.0.16",
    "aws-cdk": "0.31.0",
    "serverless-attach-managed-policy": "0.0.7",
    "serverless-cf-vars": "^0.3.0",
    "serverless-cloudformation-changesets": "0.0.2",
    "serverless-functions-base-path": "^1.0.28",
    "serverless-iam-roles-per-function": "^1.0.4",
    "serverless-plugin-tracing": "^2.0.0",
    "serverless-reqvalidator-plugin": "^1.0.3",
    "serverless-step-functions": "^2.18.0",
    "typescript": "^3.5.3"
  }
}
